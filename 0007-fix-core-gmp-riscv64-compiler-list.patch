From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Plant <tom@tplant.com.au>
Date: Sat, 5 Sep 2026 08:28:35 +0000
Subject: [PATCH] fix(gmp): Add cc to the riscv64 compiler list

gmp lists candidate compilers per host CPU. Every arch offers "cc" alongside
"gcc", except riscv64, which offers "gcc" alone, and core-llvm installs clang
as cc with no gcc.

Signed-off-by: Tom Plant <tom@tplant.com.au>
---
 packages/core/gmp/Containerfile | 1 +
 1 file changed, 1 insertion(+)

diff --git a/packages/core/gmp/Containerfile b/packages/core/gmp/Containerfile
index b7310f773..6ff53e45c 100644
--- a/packages/core/gmp/Containerfile
+++ b/packages/core/gmp/Containerfile
@@ -17,6 +17,7 @@ ADD fetch/gmp-${VERSION}.tar.xz .
 WORKDIR /gmp-${VERSION}
 RUN --network=none <<EOF
 	set -eux
+	sed -i '/^  riscv64-\*-\*)/,/^    ;;/s|cclist="gcc"|cclist="gcc cc"\n    cc_cflags="-O2"|' configure
 	./configure \
 		--prefix=/usr \
 		--build=$(uname -m)-linux-musl
