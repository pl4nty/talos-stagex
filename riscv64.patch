diff --git a/packages/core/gcc/Containerfile b/packages/core/gcc/Containerfile
index bbf307c..232d088 100644
--- a/packages/core/gcc/Containerfile
+++ b/packages/core/gcc/Containerfile
@@ -31,6 +31,8 @@ RUN --network=none <<-EOF
 		&& ARCH="x86_64"
 	[[ "$TARGETARCH" == "arm64" ]] \
 		&& ARCH="aarch64"
+	[[ "$TARGETARCH" == "riscv64" ]] \
+		&& ARCH="riscv64"
 	TARGET=$ARCH-unknown-linux-musl
 	# Find the latest clang runtime.
 	CLANG_VER="$(ls -d /lib/clang/*/ | sort -V | tail -1 | xargs basename)"
@@ -110,10 +112,19 @@ RUN --network=none <<-EOF
 		--with-gxx-include-dir=/usr/include/c++/15.2.0 \
 		--with-gxx-libcxx-include-dir=/usr/include/c++/v1 \
     libat_cv_have_ifunc=no
+EOF
+# can't mount riscv64-linux-musl because it's renamed during build
+RUN --mount=type=cache,target=/gcc-${VERSION}/build-riscv64-linux-musl \
+	--mount=type=cache,target=/gcc-${VERSION}/host-riscv64-linux-musl \
+	--network=none <<-EOF
 	make -j "$(nproc)"
 EOF
-RUN make -j "$(nproc)" all-target-libgcc
-RUN make DESTDIR=/rootfs install-strip install-target-libgcc
+RUN --mount=type=cache,target=/gcc-${VERSION}/build-riscv64-linux-musl \
+	--mount=type=cache,target=/gcc-${VERSION}/host-riscv64-linux-musl \
+	make -j "$(nproc)" all-target-libgcc
+RUN --mount=type=cache,target=/gcc-${VERSION}/build-riscv64-linux-musl \
+	--mount=type=cache,target=/gcc-${VERSION}/host-riscv64-linux-musl \
+	make DESTDIR=/rootfs install-strip install-target-libgcc
 RUN [ ! -d /rootfs/usr/lib64 ] || ( mv /rootfs/usr/lib64/* /rootfs/usr/lib/ && rm -rf /rootfs/usr/lib64 )
 
 FROM stagex/core-filesystem AS package
