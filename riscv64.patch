diff --git a/packages/bootstrap/stage2/Containerfile b/packages/bootstrap/stage2/Containerfile
index 327b016..3e27153 100644
--- a/packages/bootstrap/stage2/Containerfile
+++ b/packages/bootstrap/stage2/Containerfile
@@ -237,7 +237,7 @@ COPY --chmod=755 <<-'EOF' /linux.sh
 	cp -r /linux-${LINUX_VERSION} /linux-build-${TARGET_ARCH}
 	cd /linux-build-${TARGET_ARCH}
 	set -eux
-	make -j$(nproc) ARCH="$(echo ${TARGET_ARCH} | sed 's/aarch64/arm64/')" headers
+	make -j$(nproc) ARCH="$(echo ${TARGET_ARCH} | sed 's/aarch64/arm64/' | sed 's/riscv64/riscv/')" headers
 	find usr/include ! -name '*.h' -type f -delete
 	cp -Rv usr/include/* "${SYSROOT}/include/"
 	rm -rf "${SYSROOT}/_tmp"
